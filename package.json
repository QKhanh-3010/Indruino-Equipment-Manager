{
  "name": "indruino-equipment-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Indruino Equipment Manager - He thong quan ly trang thiet bi / vat tu Phong San xuat",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "demo": "esbuild scripts/demo-flows.ts --bundle --platform=node --format=esm --outfile=tmp/demo-flows.mjs --log-level=warning && node tmp/demo-flows.mjs"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
